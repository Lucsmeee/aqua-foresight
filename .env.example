# Copie para .env e ajuste. Nunca versione o .env.
AQUA_DATABASE_URL=sqlite:///./data/aqua_foresight.db
# AQUA_DATABASE_URL=postgresql+psycopg://aqua:aqua_dev_only@localhost:5432/aqua
AQUA_RAW_DIR=./data/raw
AQUA_HTTP_TIMEOUT=30
# Parâmetro de sistema provisório (decisão D-04), não é norma:
AQUA_MAX_DEFASAGEM_OBSERVACAO_DIAS=7
AQUA_DB_PASSWORD=aqua_dev_only
